<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Arcacon.NET</PackageId>
    <Description>비공식 아카라이브 아카콘(Arcacon) .NET 라이브러리. WPF, WinForms, Console 등 일반 .NET 앱에서 사용하세요. WinUI 3 앱은 Arcacon.NET.WinRT 패키지를 사용하세요.</Description>
    <!-- WPF/WinForms/Console 앱용: CsWinRT projection 미사용 -->
    <WebView2EnableCsWinRTProjection>false</WebView2EnableCsWinRTProjection>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="AngleSharp" Version="1.6.0" />
    <PackageReference Update="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Update="System.Net.Http.WinHttpHandler" Version="10.0.10" />
  </ItemGroup>

</Project>
